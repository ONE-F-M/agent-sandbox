# Start from Ubuntu 22.04
FROM ubuntu:22.04

# NOTE: GITHUB_TOKEN is passed via BuildKit --secret at build time.
# It is available to RUN commands via --mount=type=secret,id=github_token
# and is NEVER baked into image layers.

# Accept organization name (default: ONE-F-M)
ARG HUB_ORG=ONE-F-M
ENV HUB_ORG=${HUB_ORG}

# Install all dependencies and clear apt/pip cache
RUN rm -rf /var/lib/apt/lists/* && apt-get clean && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-missing \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    mariadb-server \
    redis-server \
    curl gnupg2 \
    sudo git && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    pip cache purge || true

# Install Node.js 20 (LTS) and npm — 18 is NOT enough: helpdesk's frontend
# needs >=20.19.0, and apps/processa's own CLAUDE.md states 20.x as its
# stack requirement. onefm-ai-agent's Dockerfile uses 18 safely only because
# it never installs either of those two apps.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn

# Install wkhtmltopdf and tree utility
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y xfonts-base xfonts-75dpi tree wkhtmltopdf && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install bench CLI globally (not with --user) and verify install
RUN python3.11 -m pip install --no-cache-dir frappe-bench && ls -l /usr/local/bin/bench

# dev_agent_server.py's own coding loop calls the Anthropic API directly —
# it runs via system python3 (see entrypoint.sh), not the bench's own venv,
# so this must be installed here, not via any app's requirements.txt.
RUN python3.11 -m pip install --no-cache-dir anthropic

# Copy the build stages + their shared libraries separately, and fix
# Windows line endings on each (CRLF -> LF). Kept as distinct COPY/RUN
# pairs deliberately: Docker's cache is per-layer, so a change to a later
# stage's script never invalidates an earlier stage's already-cached layer —
# see each script's own header for why that matters (a single-script version
# of this cost two full ~45-minute re-clones to recover from a late failure).
#
# The clone stage is 4 scripts (02a/02b/02c/02d), not 1 — see
# lib_clone_functions.sh's own header: one RUN cloning all 18 apps produced
# a single ~6.4GB layer that a connection drop (Docker Desktop's own
# internal proxy killing long-lived large uploads, not a bandwidth problem)
# forced restarting from zero, repeatedly, with no way to land a full push.
COPY lib_pin_apps.sh lib_clone_functions.sh 01_init_bench.sh \
     02a_clone_public_apps.sh 02b_clone_onefm_apps_1.sh \
     02c_clone_onefm_apps_2.sh 02d_clone_lms_and_mobile.sh \
     03_install_requirements.sh /
RUN sed -i 's/\r$//' /lib_pin_apps.sh /lib_clone_functions.sh /01_init_bench.sh \
        /02a_clone_public_apps.sh /02b_clone_onefm_apps_1.sh \
        /02c_clone_onefm_apps_2.sh /02d_clone_lms_and_mobile.sh \
        /03_install_requirements.sh && \
    chmod +x /01_init_bench.sh /02a_clone_public_apps.sh /02b_clone_onefm_apps_1.sh \
        /02c_clone_onefm_apps_2.sh /02d_clone_lms_and_mobile.sh /03_install_requirements.sh

# Create frappe user and bench directory
RUN useradd -ms /bin/bash frappe && mkdir -p /home/frappe/frappe-bench && chown -R frappe:frappe /home/frappe

USER frappe
WORKDIR /home/frappe

# frappe/lms (a real dependency of one_lms — see lib_pin_apps.sh's `lms`
# entry) declares engines.node >=22 in its package.json, which yarn
# enforces as a hard error during `bench get-app`'s clone-time
# `yarn install` — confirmed live, it aborts the whole clone before
# --skip-assets even gets a chance to matter. Not worth bumping the whole
# image to Node 22 over one dependency-of-a-dependency's frontend tooling
# that this sandbox never builds or serves (lms is only here so one_lms's
# Python import resolves) — ignore-engines just turns that check back into
# a warning, same as it is for any app that doesn't declare an upper bound.
# Must run as the `frappe` user (after USER frappe above, not before) —
# yarn config writes to $HOME/.yarnrc, and the clone/install RUN steps
# below all run as frappe (HOME=/home/frappe), not root: confirmed the
# hard way, setting this as root before the USER switch left frappe's own
# yarn reads seeing no override at all.
RUN yarn config set ignore-engines true

# Only set up bench and clone app code, not DB-dependent steps (site creation
# happens per run, at container start — see entrypoint.sh). Each stage that
# needs to clone the private ONE-F-M repos gets its own --secret mount.
RUN --mount=type=secret,id=github_token,mode=0444 \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) \
    /01_init_bench.sh /home/frappe/frappe-bench version-15 version-15

# Four separate clone stages, four separate layers — see
# lib_clone_functions.sh's header for why: keeping each one's upload small
# means a dropped connection only costs that one stage's retry, not a
# ~6.4GB all-18-apps blob starting over from zero every time.
RUN --mount=type=secret,id=github_token,mode=0444 \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) \
    /02a_clone_public_apps.sh /home/frappe/frappe-bench

RUN --mount=type=secret,id=github_token,mode=0444 \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) \
    /02b_clone_onefm_apps_1.sh /home/frappe/frappe-bench

RUN --mount=type=secret,id=github_token,mode=0444 \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) \
    /02c_clone_onefm_apps_2.sh /home/frappe/frappe-bench

RUN --mount=type=secret,id=github_token,mode=0444 \
    GITHUB_TOKEN=$(cat /run/secrets/github_token) \
    /02d_clone_lms_and_mobile.sh /home/frappe/frappe-bench

RUN /03_install_requirements.sh /home/frappe/frappe-bench

# ── WI-004006: browser testing toolchain + built Desk assets ──────────────────
# Placed AFTER the clone/requirements layers on purpose: editing anything below
# never invalidates the ~45-minute clone layers above.
#
# Playwright is installed globally (outside every app checkout — house rule B7,
# no app package.json is touched). Pin: bump PLAYWRIGHT_VERSION to upgrade; the
# Chromium build is fetched by that same CLI, so they cannot drift apart.
# ENV (not just ARG) so verify_browser_env.sh and every later `docker exec` see them.
USER root
ENV PLAYWRIGHT_VERSION=1.49.1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NODE_PATH=/usr/lib/node_modules
# GitHub CLI from GitHub's own apt repo (Ubuntu's packaged gh is far older than 2.103;
# the actual version is asserted by verify_browser_env.sh below, not assumed).
RUN mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y gh fontconfig fonts-noto-core fonts-noto-ui-core && \
    npm install -g @playwright/test@${PLAYWRIGHT_VERSION} && \
    npx playwright install --with-deps chromium && \
    chmod -R a+rX /opt/pw-browsers && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

USER frappe
# Desk bundles (AC2). The ARG is declared in the same stage, right above the RUN
# that uses it, so it is in scope here without any shell state from an earlier layer.
# helpdesk is deliberately not in the list (its build breaks — see 03_install_requirements.sh).
ARG DESK_BUILD_APPS=frappe,erpnext,hrms,processa,one_fm
RUN cd /home/frappe/frappe-bench && bench build --apps "${DESK_BUILD_APPS}"

COPY --chown=frappe:frappe browser_smoke/ /opt/playwright-smoke/
USER root
RUN sed -i 's/\r$//' /opt/playwright-smoke/*.sh && chmod +x /opt/playwright-smoke/*.sh
USER frappe
RUN /opt/playwright-smoke/verify_browser_env.sh

WORKDIR /home/frappe/frappe-bench

USER root
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Generic driver — copied in, config-free (see dev_agent_server.py).
COPY dev_agent_server.py session_agent.py /home/frappe/
RUN chown frappe:frappe /home/frappe/dev_agent_server.py /home/frappe/session_agent.py

ENTRYPOINT ["/entrypoint.sh"]
